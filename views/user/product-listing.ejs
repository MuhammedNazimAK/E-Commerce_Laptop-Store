<%- include("../partials/user/header") %>
<%- include("../partials/user/right") %>
<style>
  .breadcrumb-wrapper--compact {
    padding-top: 8px !important;
    padding-bottom: 16px !important;
    margin-bottom: 0 !important;
  }
</style>
    <!-- ...:::: Start Breadcrumb Section:::... -->
    <div class="breadcrumb-section p-0">
        <div class="breadcrumb-wrapper p-0 breadcrumb-wrapper--compact">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="breadcrumb-nav breadcrumb-nav-color--black breadcrumb-nav-hover-color--golden text-start d-flex justify-content-start my-0 py-0">
                            <nav aria-label="breadcrumb">
                                <ul class="m-0 p-0">
                                    <li><a href="home">Home</a></li>
                                    <li><a href="product-listing">Shop</a></li>
                                    <li class="active" aria-current="page">Products</li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div> <!-- ...:::: End Breadcrumb Section:::... -->

    <!-- ...:::: Start Shop Section :::... -->
    <div class="shop-section">
        <div class="container">
            <div class="row flex-column-reverse flex-lg-row">
                <div class="col-lg-3">
                    <!-- Start Sidebar Area -->
                    <div class="siderbar-section" data-aos="fade-up" data-aos-delay="0">
                        
                        <!-- Filter By Price Widget -->
                        <div class="sidebar-single-widget">
                            <h6 class="sidebar-title">FILTER BY PRICE</h6>
                            <div class="sidebar-content">
                                <div id="slider-range"></div>
                                <div class="filter-type-price mt-3">
                                    <div>
                                        <label for="min-price" class="mb-0">Min:</label>
                                        <input type="text" id="min-price" class="amount form-control form-control-sm" value="0">
                                    </div>
                                    <div>
                                        <label for="max-price" class="mb-0">Max:</label>
                                        <input type="text" id="max-price" class="amount form-control form-control-sm" value="100000">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Manufacturer Widget -->
                        <div class="sidebar-single-widget">
                            <h6 class="sidebar-title">MANUFACTURER</h6>
                            <div class="sidebar-content">
                                <div class="filter-type-select">
                                    <ul>
                                        <% brands.forEach(brand => { %>
                                        <li>
                                            <label class="checkbox-default" for="brand-<%= brand %>">
                                                <input type="checkbox" id="brand-<%= brand %>" value="<%= brand %>" class="brand-filter"
                                                    <%= selectedBrand === brand ? 'checked' : '' %>>
                                                <span><%= brand %></span>
                                            </label>
                                        </li>
                                        <% }) %>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Category Widget -->
                        <div class="sidebar-single-widget">
                            <h6 class="sidebar-title">SELECT BY CATEGORY</h6>
                            <div class="sidebar-content">
                                <div class="filter-type-select">
                                    <ul>
                                        <% categories.forEach(category => { %>
                                            <% if(!category.isBlocked) { %>
                                                <li>
                                                    <label class="checkbox-default" for="category-<%= category._id %>">
                                                        <input type="checkbox" id="category-<%= category._id %>" value="<%= category._id %>" class="category-filter"
                                                            <%= selectedCategory === category._id.toString() ? 'checked' : '' %>>
                                                        <span><%= category.name %></span>
                                                    </label>
                                                </li>
                                            <% } %>
                                        <% }) %>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- RAM Widget -->
                        <div class="sidebar-single-widget">
                            <h6 class="sidebar-title">SELECT BY RAM</h6>
                            <div class="sidebar-content">
                                <div class="filter-type-select">
                                    <ul>
                                        <% rams.forEach(ram => { %>
                                        <li>
                                            <label class="checkbox-default" for="ram-<%= ram.replace(/\s/g, '-') %>">
                                                <input type="checkbox" id="ram-<%= ram.replace(/\s/g, '-') %>" value="<%= ram %>" class="ram-filter">
                                                <span><%= ram %></span>
                                            </label>
                                        </li>
                                        <% }) %>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Processor Widget -->
                        <div class="sidebar-single-widget">
                            <h6 class="sidebar-title">SELECT BY PROCESSOR</h6>
                            <div class="sidebar-content">
                                <div class="filter-type-select">
                                    <ul>
                                        <% processors.forEach(processor => { %>
                                        <li>
                                            <label class="checkbox-default" for="processor-<%= processor.replace(/\s/g, '-') %>">
                                                <input type="checkbox" id="processor-<%= processor.replace(/\s/g, '-') %>" value="<%= processor %>" class="processor-filter">
                                                <span><%= processor %></span>
                                            </label>
                                        </li>
                                        <% }) %>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Graphics Card Widget -->
                        <div class="sidebar-single-widget">
                            <h6 class="sidebar-title">SELECT BY GRAPHICS CARD</h6>
                            <div class="sidebar-content">
                                <div class="filter-type-select">
                                    <ul>
                                        <% graphicsCards.forEach(graphicsCard => { %>
                                          <% if (graphicsCard && graphicsCard.trim() !== '') { %>
                                              <li>
                                                  <label class="checkbox-default" for="graphics-card-<%= graphicsCard.replace(/\s+/g, '-') %>">
                                                      <input type="checkbox" id="graphics-card-<%= graphicsCard.replace(/\s+/g, '-') %>" value="<%= graphicsCard %>" class="graphics-card-filter">
                                                      <span><%= graphicsCard %></span>
                                                  </label>
                                              </li>
                                          <% } %>
                                        <% }) %>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div> <!-- End Sidebar Area -->
                </div>

                <div class="col-lg-9">
                    <!-- Start Shop Product Sorting Section -->
                    <div class="shop-sort-section">
                        <div class="container-fluid p-0">
                            <div class="row">
                                <div class="col-12">
                                    <div class="sort-box d-flex justify-content-between align-items-md-center align-items-start flex-md-row flex-column" data-aos="fade-up" data-aos-delay="0">
                                        <div class="sort-tablist d-flex align-items-center">
                                            <div class="page-amount ms-2">
                                                <span id="product-count">Showing 1–9 of 21 results</span>
                                            </div>
                                        </div>
                                        <div class="sort-select-list d-flex align-items-center">
                                            <label class="me-2 mb-0">Sort By:</label>
                                            <form action="#">
                                                <fieldset>
                                                    <select name="sort" id="sort-select" class="sort-select">
                                                        <option value="createdAt">Sort by newness</option>
                                                        <option value="popularity">Sort by popularity</option>
                                                        <option value="priceAsc">Sort by price: low to high</option>
                                                        <option value="priceDesc">Sort by price: high to low</option>
                                                        <option value="nameAsc">Product Name: A-Z</option>
                                                        <option value="nameDesc">Product Name: Z-A</option>
                                                    </select>
                                                </fieldset>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> <!-- End Shop Product Sorting Section -->

                    <!-- Start Tab Wrapper -->
                    <div class="sort-product-tab-wrapper" data-aos="fade-up" data-aos-delay="0">
                        <div class="container-fluid p-0">
                            <div class="row">
                                <div class="col-12">
                                    <div class="tab-content tab-animate-zoom">
                                        <!-- List View Products Container -->
                                        <div class="tab-pane active show sort-layout-single" id="layout-list">
                                            <div class="row" id="product-container">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> <!-- End Tab Wrapper -->

                    <!-- Start Pagination -->
                    <div class="page-pagination text-center mt-5 align-items-end" data-aos="fade-up" data-aos-delay="0">
                        <ul class="pagination justify-content-center" id="pagination-container">
                            <!-- Pagination items inserted dynamically -->
                        </ul>
                    </div> <!-- End Pagination -->

                </div>
            </div>
        </div>
    </div> <!-- ...:::: End Shop Section :::... -->

<%- include("../partials/user/footer") %> 
<script src="/javascript/productListing.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        $('#slider-range').slider({
            range: true,
            min: 0,
            max: 100000,
            values: [0, 100000],
            slide: function(event, ui) {
              $('#min-price').val(ui.values[0]);
              $('#max-price').val(ui.values[1]);
              filters.minPrice = ui.values[0];
              filters.maxPrice = ui.values[1];
            },
            change: function() {
              fetchProducts();
            }
          });

        fetchProducts();
    });
</script>
<script src="/javascript/wishlist.js" defer></script>