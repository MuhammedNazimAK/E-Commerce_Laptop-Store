<%- include("../partials/user/header") %>
<%- include("../partials/user/right") %>
    <div class="hero-slider-section">
        <div class="hero-slider-active swiper-container">
                <div class="hero-single-slider-item swiper-slide">
                    <div class="hero-slider-bg">
                        <img src="/assets/images/remake/fwebp_upscayl_4x_realesrgan-x4plus.webp" alt="">
                    </div>
                    <div class="hero-slider-wrapper">
                        <div class="container">
                            <div class="row">
                                <div class="col-auto">
                                    <div class="hero-slider-content">
                                        <h4 class="subtitle"></h4>
                                        <h2 class="title"> <br></h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>

 <!-- Top Products Section -->
 <div class="product-default-slider-section section-top-gap-100 section-fluid section-inner-bg">
    <div class="section-title-wrapper" data-aos="fade-up" data-aos-delay="">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="section-content-gap">
                        <div class="secton-content">
                            <h3 class="section-title">Top Products</h3>
                            <p>Add our top products to your weekly lineup.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Start Product Slider -->
    <div class="product-wrapper" data-aos="fade-up" data-aos-delay="">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="product-slider-default-1row default-slider-nav-arrow">
                        <!-- Slider main container -->
                        <div class="swiper-container product-default-slider-4grid-1row">
                            <div class="swiper-wrapper">
                                <% topProducts?.forEach((product, index) => { %>
                                    <div class="product-default-single-item product-color--golden swiper-slide">
                                        <div class="image-box" style="background-color: white;">
                                            <a href="/productDetails/<%= product._id %>" class="image-link">
                                                <img src="<%= product.images?.[0] %>" alt="<%= product.name %>">
                                            </a>
                                            <% if (!product.isPublished) { %>
                                                <div class="tag">
                                                    <span>Unavailable</span>
                                                </div>
                                            <% } else if (product.discount > 0) { %>
                                                <div class="tag">
                                                    <span><%= product.discount %>% OFF</span>
                                                </div>
                                            <% } else if (product.offerName) { %>
                                                <div class="tag">
                                                    <span><%= product.offerName %></span>
                                                </div>
                                            <% } %>
                                            <div class="action-link">
                                                <div class="action-link-left">
                                                    <% if (product.isPublished) { %>
                                                        <a href="#" onclick="addToCart('<%= product._id %>')">Add to Cart</a>
                                                    <% } else { %>
                                                        <a class="disabled">Unavailable</a>
                                                    <% } %>
                                                </div>
                                                <div class="action-link-right">
                                                  <a href="#" class="add-to-wishlist <%= product.inWishlist ? 'added-to-wishlist' : '' %>" data-product-id="<%= product._id %>">
                                                    <i class="icon-heart"></i>
                                                  </a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="content">
                                            <div class="content-left">
                                                <h6 class="title">
                                                    <a href="/productDetails/<%= product._id %>"><%= product.name %></a>
                                                </h6>
                                                <!-- Default Rating -->
                                                <ul class="review-star">
                                                    <li class="fill"><i class="ion-android-star"></i></li>
                                                    <li class="fill"><i class="ion-android-star"></i></li>
                                                    <li class="fill"><i class="ion-android-star"></i></li>
                                                    <li class="fill"><i class="ion-android-star"></i></li>
                                                    <li class="empty"><i class="ion-android-star"></i></li>
                                                </ul>
                                            </div>
                                            <div class="content-right">
                                                <% if (product.discountedPrice < product.originalPrice) { %>
                                                    <span style="color: red;" class="price">₹<%= product.discountedPrice.toFixed(2) %></span>
                                                    <del class="original-price">₹<%= product.originalPrice.toFixed(2) %></del>
                                                <% } else { %>
                                                    <span class="price">₹<%= product.originalPrice?.toFixed(2) %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- End Product Default Single Item -->
                                <% }); %>
                            </div>
                        </div>
                        <!-- If we need navigation buttons -->
                        <div class="swiper-button-prev"></div>
                        <div class="swiper-button-next"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Product Default Slider Section -->
</div>


<!-- Top Brands Section -->
<div class="banner-section section-top-gap-100">
    <div class="section-title-wrapper" data-aos="fade-up" data-aos-delay="0">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="section-content-gap">
                        <div class="secton-content">
                            <h3 class="section-title">Top Brands</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="banner-wrapper clearfix">
        <% topBrands.forEach((brand, index) => { %>
            <a href="/product-listing?brand=<%= encodeURIComponent(brand._id) %>" class="banner-single-item banner-style-7 banner-animation banner-color--green float-left" data-aos="fade-up" data-aos-delay="">
                <div class="image">
                    <img class="img-fluid" src="/assets/images/Brands/<%= brand._id?.toLowerCase() %>.webp" alt="<%= brand._id %>">
                </div>
                <div class="content">
                    <div class="inner">
                        <h4 class="title"><%= brand._id %></h4>
                        <h6 class="sub-title"><%= brand.count %> products</h6>
                    </div>
                </div>
            </a>
        <% }); %>
    </div>
</div>


<!-- Categories Section -->
<div class="banner-section section-top-gap-100">
    <div class="section-title-wrapper" data-aos="fade-up" data-aos-delay="0">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="section-content-gap">
                        <div class="secton-content">
                            <h3 class="section-title">Shop by Category</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="banner-wrapper clearfix">
        <% categories.forEach((category, index) => { %>
            <a href="/product-listing?category=<%= encodeURIComponent(category.name.toLowerCase()) %>" class="content">
                <div class="banner-single-item banner-style-4 banner-animation banner-color--golden float-left img-responsive" data-aos="fade-up" data-aos-delay="">
                <div class="image">
                    <img class="img-fluid" src="/assets/images/Category/<%= category.name.toLowerCase() %>.webp" alt="<%= category.name %>">
                </div>
                    <span class="round-btn"><i class="ion-ios-arrow-thin-right"></i></span>
                </div>
            </a>                  
        <% }); %>
    </div>
</div>



 

